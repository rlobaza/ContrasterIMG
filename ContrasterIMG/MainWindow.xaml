<Window x:Class="ContrasterIMG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ContrasterIMG"
        mc:Ignorable="d"
        Title="ContrasterIMG" Height="450" Width="800"
        Icon="\Images\icon.ico">

    <Window.Resources>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Menu>
                <MenuItem Header="Image">
                    <MenuItem Header="Load" Click="BrowseFile_Click">
                        <MenuItem.Icon>
                            <Image Source="/Images/load.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save">
                        <MenuItem.Icon>
                            <Image Source="/Images/save.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save As">
                        <MenuItem.Icon>
                            <Image Source="/Images/save.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Clear" Click="Clear_Click">
                        <MenuItem.Icon>
                            <Image Source="/Images/clear.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="Settings">
                    <MenuItem Header="Algorithm">
                        <MenuItem.Icon>
                            <Image Source="/Images/gear.png"/>
                        </MenuItem.Icon>
                        <RadioButton Content="C++" GroupName="Algorithm" IsChecked="true"/>
                        <RadioButton Content="Assembly" GroupName="Algorithm"/>
                    </MenuItem>

                    <MenuItem Header="Multithreading">
                        <MenuItem.Icon>
                            <Image Source="/Images/branch.png"/>
                        </MenuItem.Icon>
                        <RadioButton Content="OFF" GroupName="Threats" IsChecked="true"/>
                        <RadioButton Content="2" GroupName="Threats"/>
                        <RadioButton Content="4" GroupName="Threats"/>
                        <RadioButton Content="8" GroupName="Threats"/>
                        <RadioButton Content="16" GroupName="Threats"/>
                        <RadioButton Content="32" GroupName="Threats"/>
                        <RadioButton Content="64" GroupName="Threats"/>
                    </MenuItem>

                    <MenuItem Header="Execution time measurement">
                        <MenuItem.Icon>
                            <Image Source="/Images/time.png"/>
                        </MenuItem.Icon>

                        <RadioButton Content="ON" GroupName="Time" IsChecked="true"/>
                        <RadioButton Content="OFF" GroupName="Time"/>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="Help">
                    <MenuItem Header="About" Click="About_Click">
                        <MenuItem.Icon>
                            <Image Source="/Images/about.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Credits" Click="Credits_Click">
                        <MenuItem.Icon>
                            <Image Source="/Images/credits.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Background="LightGray">
                    <TextBlock Text="Input" HorizontalAlignment="Center" Grid.Row="0" FontWeight="Bold" Foreground="White"/>
                </Grid>
                <Border BorderThickness="1" BorderBrush="LightGray" Grid.Row="1" Background="WhiteSmoke">
                    <Image x:Name="InputImage" Margin="10"/>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Background="LightGray">
                    <TextBlock Text="Output" HorizontalAlignment="Center" Grid.Row="0" FontWeight="Bold" Foreground="White"/>
                </Grid>
                <Border BorderThickness="1" BorderBrush="LightGray" Grid.Row="1" Background="WhiteSmoke">
                    <Image x:Name="OutputImage" Margin="10"/>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Input file directory" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="path:"/>
                        <TextBox Margin="5" Width="250" x:Name="InputPathTextBox" TextChanged="InputPath_Changed"/>
                        <Button Content="Browse" Margin ="5" Width="75" Click="BrowseFile_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Output directory" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="path:"/>
                        <TextBox Margin="5" Width="250" x:Name="OutputPathTextBox"/>
                        <Button Content="Browse" Margin ="5" Width="75" Click="BrowseFolder_Click"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Grid>

    </Grid>
</Window>
