<Window x:Class="ContrasterIMG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ContrasterIMG"
        mc:Ignorable="d"
        Title="ContrasterIMG" Height="450" Width="800"
        Icon="\Images\icon.ico">

    <Window.Resources>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Menu>
                <MenuItem Header="Image">
                    <MenuItem Header="Load" Click="BrowseFile_Click">
                        <MenuItem.Icon>
                            <Image Source="/Images/load.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save">
                        <MenuItem.Icon>
                            <Image Source="/Images/save.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save As">
                        <MenuItem.Icon>
                            <Image Source="/Images/save.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Clear" Click="Clear_Click">
                        <MenuItem.Icon>
                            <Image Source="/Images/clear.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="Settings">
                    <MenuItem Header="Algorithm">
                        <MenuItem.Icon>
                            <Image Source="/Images/gear.png"/>
                        </MenuItem.Icon>
                        <RadioButton Content="C++" GroupName="Algorithm" IsChecked="true" Click="Config_Change" x:Name="AlgCpp"/>
                        <RadioButton Content="Assembly" GroupName="Algorithm" Click="Config_Change" x:Name="AlgAsm"/>
                    </MenuItem>

                    <MenuItem Header="Multithreading">
                        <MenuItem.Icon>
                            <Image Source="/Images/branch.png"/>
                        </MenuItem.Icon>
                        <RadioButton Content="Off" GroupName="Threats" IsChecked="true" Click="Config_Change" x:Name="ThOff"/>
                        <RadioButton Content="2" GroupName="Threats" Click="Config_Change" x:Name="Th2"/>
                        <RadioButton Content="4" GroupName="Threats" Click="Config_Change" x:Name="Th4"/>
                        <RadioButton Content="8" GroupName="Threats" Click="Config_Change" x:Name="Th8"/>
                        <RadioButton Content="16" GroupName="Threats" Click="Config_Change" x:Name="Th16"/>
                        <RadioButton Content="32" GroupName="Threats" Click="Config_Change" x:Name="Th32"/>
                        <RadioButton Content="64" GroupName="Threats" Click="Config_Change" x:Name="Th64"/>
                    </MenuItem>

                    <MenuItem Header="Execution time measurement">
                        <MenuItem.Icon>
                            <Image Source="/Images/time.png"/>
                        </MenuItem.Icon>

                        <RadioButton Content="On" GroupName="Time" IsChecked="true" Click="Config_Change" x:Name="TimeOn"/>
                        <RadioButton Content="Off" GroupName="Time" Click="Config_Change" x:Name="TimeOff"/>
                    </MenuItem>

                    <MenuItem Header="Autosave">
                        <MenuItem.Icon>
                            <Image Source="/Images/save.png"/>
                        </MenuItem.Icon>

                        <RadioButton Content="On" GroupName="Autosave" IsChecked="true" Click="Config_Change" x:Name="AutosaveOn"/>
                        <RadioButton Content="Off" GroupName="Autosave" Click="Config_Change" x:Name="AutosaveOff"/>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="Help">
                    <MenuItem Header="About" Click="About_Click">
                        <MenuItem.Icon>
                            <Image Source="/Images/about.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Credits" Click="Credits_Click">
                        <MenuItem.Icon>
                            <Image Source="/Images/credits.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Background="LightGray">
                    <TextBlock Text="Input" HorizontalAlignment="Center" Grid.Row="0" FontWeight="Bold" Foreground="White"/>
                </Grid>
                <Border BorderThickness="1" BorderBrush="LightGray" Grid.Row="1" Background="WhiteSmoke">
                    <Image x:Name="InputImage" Margin="10"/>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Background="LightGray">
                    <TextBlock Text="Output" HorizontalAlignment="Center" Grid.Row="0" FontWeight="Bold" Foreground="White"/>
                </Grid>
                <Border BorderThickness="1" BorderBrush="LightGray" Grid.Row="1" Background="WhiteSmoke">
                    <Image x:Name="OutputImage" Margin="10"/>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Input file directory" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="path:"/>
                        <TextBox Width="250" Height="20" x:Name="InputPathTextBox" TextChanged="InputPath_Changed"/>
                        <Button Content="..." Width="20" Height="20" Margin="-5, 0, 0, 0"  Click="BrowseFile_Click"/>
                        <Button Margin ="5" Width="75" IsEnabled="false" x:Name="UploadButton" Click="Upload_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Upload" Margin="0, 0, 5, 0"/>
                                <Image Source="/Images/upload.png" Width="16" Height="16" Opacity="0.2" x:Name="Upload_Icon"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Output directory" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="path:"/>
                        <TextBox Width="250" Height="20" x:Name="OutputPathTextBox" TextChanged="OutputPath_Changed"/>
                        <Button Content="..." Width="20" Height="20" Margin="-5, 0, 0, 0" Click="BrowseFolder_Click"/>
                        <Button Margin ="5" Width="75" IsEnabled="false" x:Name="OpenButton" Click="Open_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Open" Margin="0, 0, 5, 0"/>
                                <Image Source="/Images/load.png" Width="16" Height="16" Opacity="0.2" x:Name="Open_Icon"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Slider Margin="3" Minimum="-100" Maximum="100" Value="0" TickPlacement="BottomRight" TickFrequency="10" IsSnapToTickEnabled="false" x:Name="ContrastSlider" ValueChanged="Slider_ValueChanged"/>
                </Grid>
                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Width="21" Height="20" Margin="71, 0, -6, 0" HorizontalAlignment="Left" IsEnabled="false" x:Name="CenterButton" Click="Center_Click">
                            <Image Source="/Images/center.png" IsEnabled="false" x:Name="CenterIcon" Opacity="0.2" Width="16" Height="16"/>
                        </Button>
                        <TextBox Width="100" Margin="5" Text="0" TextAlignment="Center" x:Name="SliderPositionBox" KeyDown="SliderPositionBox_TextChanged"/>
                        <Button Content="Apply" Width="75" Height="20" Margin="5" HorizontalAlignment="Right" IsEnabled="false" x:Name="ApplyButton" Click="Apply_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal">
                        <Grid>
                            <ProgressBar Margin="5"  Height="15" Width="250" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock Text="status: waiting" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Black" FontStyle="Italic"/>
                        </Grid>
                        <Border BorderThickness="0.5" BorderBrush="Gray" Margin="5" Width="120">
                            <Grid>
                                <Image Source="/Images/time.png" Height="16" Width="16" Margin="5, 0, 0, 0" HorizontalAlignment="Left"/>
                                <TextBlock Text="N/A" Margin="30, 0, 30, 0" TextAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Window>
